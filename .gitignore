# Dependencies
node_modules/

# Environment variables (never commit real secrets)
.env
.env.*
!.env.example

# Build output
dist/
.angular/

# Uploaded files (keep the folder, ignore its contents)
uploads/*
!uploads/.gitkeep

# IDE / editors
.idea/
*.iml
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Logs & system files
*.log
npm-debug.log*
.DS_Store
Thumbs.db
