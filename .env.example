# Copy this file to `.env` and fill in your own values.

# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://localhost:27017/Shop

# Authentication (use a long random string)
JWT_SECRET=replace_with_a_long_random_secret

# Optional: credentials used by `npm run seed`
ADMIN_USERNAME=admin
ADMIN_PASSWORD=password

# Stripe and SMTP credentials are NOT stored here.
# They are configured from the manager dashboard and saved in the database.
